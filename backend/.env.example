# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql://govflow:govflow_secret@localhost:5460/govflow_dev
OPENAI_API_KEY=

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# Optional, minutes (default 1440 = 1 day)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Chat agent ---
CHAT_MODEL=gpt-5.5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# "postgres" (default, survives restarts) or "memory" (tests / quick experiments)
CHAT_CHECKPOINTER=postgres
CHAT_DB_POOL_SIZE=10

# --- Rate limits (per client IP, "N/period") ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_SCRAPE_SYNC=5/hour
# Use redis://host:6379 when running more than one server process
RATE_LIMIT_STORAGE_URI=memory://
